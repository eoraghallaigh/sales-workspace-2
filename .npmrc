# This prototype uses public npm packages (Vite, React, shadcn/ui), which are NOT
# served by HubSpot's internal registry (npm.hubteam.com, set in ~/.npmrc).
# Pin this project to the public registry so `npm install` / `npm run dev` work
# without passing --registry every time. Scoped to this folder; does not affect
# other HubSpot projects.
registry=https://registry.npmjs.org/
